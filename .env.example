# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values before running docker compose.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---- Anthropic ----
# Anthropic API key (required). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model used to classify urgency and propose a crew.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Database ----
DB_NAME=maintenance
# Least-privilege account the MCP server connects with. It is created
# automatically inside the bundled MySQL container on first boot.
DB_USER=triage_app
DB_PASSWORD=change-me-app-password
# Root password used to provision the bundled MySQL container.
MYSQL_ROOT_PASSWORD=change-me-root-password
# Port on your own machine that the database is published on, for MySQL
# Workbench or a CLI client. Bound to 127.0.0.1 only.
DB_HOST_PORT=3307

# ---- Human-in-the-loop approval ----
# Shared secret used to sign approval grants. The backend mints a grant when a
# maintenance lead clicks Approve; the MCP write tool refuses to assign a crew
# unless it is presented with a valid, unexpired, unredeemed grant signed with
# this key. Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_SIGNING_SECRET=change-me-generate-a-long-random-secret
# How long an approval stays valid, in seconds. Short by design: the grant is
# minted at the moment of the click and redeemed immediately after.
APPROVAL_TTL_SECONDS=120

# ---- Triage behaviour ----
# Crew that a work order re-routes to when the safety rule had to override the
# model's classification. Leave empty to keep whichever crew the model proposed.
SAFETY_CREW_CODE=SRR-D

# ---- Backend ----
# CORS origins. "*" is fine for local use; set your real origin in production.
CORS_ORIGINS=*
